# Copy this file to `.env` and fill in the values.
# `.env` is gitignored; never commit real secrets.

# ---------------------------------------------------------------------------
# Public site configuration (inlined into the client bundle at build time)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AdSense publisher ID. Leave empty (or delete the line) to disable ads.
# The in-page AdSense script only loads in production builds.
# NOTE: `public/ads.txt` also contains an AdSense publisher ID. If you are not
# the deployer of pasarmalam.app, replace or delete that file — it must match
# the account receiving ads on your own domain.
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=

# ---------------------------------------------------------------------------
# Admin authentication (server-only secrets)
# ---------------------------------------------------------------------------
# Password for the single admin account at /admin/login.
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session JWT. Use a long random string, e.g.
# `openssl rand -base64 32` or `node -e "console.log(crypto.randomUUID())"`.
JWT_SECRET=change-me-too

# Optional display name for the admin account. Defaults to "admin".
ADMIN_EMAIL=admin@example.com
