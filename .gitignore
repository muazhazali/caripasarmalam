# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/
/.open-next/
next-env.d.ts

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep the committed examples)
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# cloudflare / wrangler local dev state
/.wrangler/
**/.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# editor and agent-local files (personal, machine-specific)
.claude/
.cursor/
.kilo/
.vercel/

# supabase data backups (contain submitter emails; keep out of repo)
/docs/archive/supabase/
