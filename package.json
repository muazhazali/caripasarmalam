{
  "name": "caripasarmalam",
  "version": "0.1.0",
  "private": true,
  "description": "Community directory of night markets (pasar malam) across Malaysia. Next.js on Cloudflare Workers with D1.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muazhazali/caripasarmalam.git"
  },
  "homepage": "https://pasarmalam.app",
  "bugs": {
    "url": "https://github.com/muazhazali/caripasarmalam/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,css}\"",
    "preview": "opennextjs-cloudflare build && wrangler dev --config wrangler.jsonc --config workers/rate-limiter/wrangler.jsonc --port 8787",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:rate-limiter": "wrangler deploy --config workers/rate-limiter/wrangler.jsonc",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply caripasarmalam --local",
    "db:migrate:remote": "wrangler d1 migrations apply caripasarmalam --remote",
    "db:seed:local": "wrangler d1 execute caripasarmalam --local --file d1/data.sql"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,css}": "prettier --write"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "country-flag-icons": "^1.6.17",
    "geist": "latest",
    "jose": "^6.2.12",
    "leaflet": "latest",
    "lucide-react": "^0.544.0",
    "next": "^16.2.11",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.75.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.26",
    "prettier": "3.6.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "1.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.138.0"
  }
}
